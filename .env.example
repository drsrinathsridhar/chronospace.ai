# The site's public origin. Every absolute URL the build emits - canonical,
# og:url, sitemap, robots - is built from it. It can stay unset: on Vercel the
# app falls back to the project's production hostname, then the deployment's
# own, and only a local build lands on localhost (src/lib/env.ts). Set it in
# the Vercel project once the launch domain is known.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
